# Local stdio is the safest default. For demo-only HTTP, set streamable-http.
MCP_TRANSPORT=stdio
MCP_HOST=127.0.0.1
MCP_PORT=8000

# Local cache, SQLite assessments, snapshots, and analyst decisions.
DATA_DIR=.vulncompass

# Optional. NVD works without a key at a lower rate limit.
NVD_API_KEY=

# Optional community supporting evidence. Metadata only; templates are never run.
NUCLEI_TEMPLATES_ENABLED=true
NUCLEI_TEMPLATES_REF=main
REQUEST_TIMEOUT_SECONDS=20
CACHE_TTL_SECONDS=86400
